{
  "versao": 1,
  "nota": "Catálogo único dos blocos do visor e das ações que a voz pode disparar. Lido pelo front (web/ui/comandos.js) e pela API (api/comandos.py). 'falado' = nome no alfabeto fonético, que o Whisper transcreve bem (letra solta não: bê/dê/ê/pê/tê soam iguais). Ação nova: acrescentar aqui e registrar o handler em web/app.js.",
  "modais": [
    {
      "id": "m-A", "falado": ["alfa", "alpha", "alfah"], "nome": "Mapa", "seletor": "#mapa-box",
      "sinonimos": ["mapa"],
      "acoes": {
        "expandir": {"desc": "abre o mapa em tela cheia", "falado": ["expandir", "abrir", "abre", "maximizar", "tela cheia", "explorar"]},
        "recolher": {"desc": "volta o mapa ao círculo", "falado": ["recolher", "fechar", "fecha", "minimizar", "esconder"]},
        "aproximar": {"desc": "zoom mais", "falado": ["aproximar", "aproxima", "zoom mais", "mais zoom", "aumentar zoom", "aumenta zoom", "aumentar o zoom", "aumenta o zoom", "ampliar", "chegar perto"],
          "args": {"niveis": {"tipo": "inteiro", "min": 1, "max": 4, "padrao": 1}}},
        "afastar": {"desc": "zoom menos", "falado": ["afastar", "afasta", "zoom menos", "menos zoom", "diminuir zoom", "diminui zoom", "diminuir o zoom", "diminui o zoom", "reduzir zoom", "reduzir o zoom"],
          "args": {"niveis": {"tipo": "inteiro", "min": 1, "max": 4, "padrao": 1}}},
        "mover": {"desc": "desloca o mapa para um lado", "falado": ["mover", "move", "andar", "anda", "deslocar", "desloca"],
          "args": {"direcao": {"tipo": "enum", "valores": {"norte": ["norte", "cima"], "sul": ["sul", "baixo"], "leste": ["leste", "direita"], "oeste": ["oeste", "esquerda"]}}}},
        "centralizar": {"desc": "centra na posição atual ou na rota", "falado": ["centralizar", "centraliza", "centrar", "centra", "onde estou", "minha posicao"]}
      }
    },
    {
