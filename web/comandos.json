          "args": {"camada": {"tipo": "enum", "valores": {"relevo_hillshade": ["relevo", "hillshade", "sombra"], "themis_ti": ["inercia", "termica", "themis"], "risco_previsto": ["risco", "inclinacao"]}}}},
        "desligar": {"desc": "esconde uma camada", "falado": ["desligar", "desliga", "esconder", "esconde", "ocultar", "oculta", "apagar", "apaga", "tirar", "tira"],
          "args": {"camada": {"tipo": "enum", "valores": {"relevo_hillshade": ["relevo", "hillshade", "sombra"], "themis_ti": ["inercia", "termica", "themis"], "risco_previsto": ["risco", "inclinacao"]}}}},
        "opacidade": {"desc": "ajusta a opacidade de uma camada (0 a 100 %)", "falado": ["opacidade", "transparencia"],
          "args": {"camada": {"tipo": "enum", "valores": {"relevo_hillshade": ["relevo", "hillshade", "sombra"], "themis_ti": ["inercia", "termica", "themis"], "risco_previsto": ["risco", "inclinacao"]}},
                   "valor": {"tipo": "inteiro", "min": 0, "max": 100}}}
      }
